# 🐳 Docker Compose

version: '3'
services:
  web:
    image: nginx
    ports:
      - "8080:80"
  db:
    image: mongo
    volumes:
      - mongo-data:/data/db

volumes:
  mongo-data:

## Docker Compose Commands:

# Start services
docker-compose up -d

# Stop and remove services
docker-compose down
